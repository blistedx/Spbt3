PORT=3000

# MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
# If left blank, the app will automatically start an in-memory/embedded database for local testing
MONGODB_URI=

# Security secrets & PINs (Use strong random values in production)
JWT_SECRET=your_jwt_secret_key_here
DEFAULT_ADMIN_PIN=1234
DEFAULT_SCORER_PIN=123456

# Tournament Venue Google Maps Link
COURT_MAPS_URL=https://maps.google.com

# Admin notification emails (comma-separated list of emails)
ADMIN_EMAILS=admin@example.com,organizer@example.com
